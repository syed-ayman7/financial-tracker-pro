# Fin-Tracker Environment Variables
# Copy this file to .env and fill in the values

# Neon Postgres connection string
# Get this from your Neon dashboard → Connection Details → Connection string
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Password to access the app (simple password gate, no user accounts)
APP_PASSWORD="change-me-to-something-strong"
